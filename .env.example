# Copy to .env and point these at your own checkout.
# .env is gitignored.

COS_ROOT=C:\Users\<you>\OneDrive\CoS
COS_WORKBOOK_PATH=C:\Users\<you>\OneDrive\CoS\workbook\Chief_of_Staff_Tracker.xlsx
COS_STATE_PATH=C:\Users\<you>\OneDrive\CoS\data\state.json
COS_LOG_DIR=C:\Users\<you>\OneDrive\CoS\data\logs
COS_OUTPUT_DIR=C:\Users\<you>\OneDrive\CoS\data\outputs

COS_USER_EMAIL=you@yourbrokerage.com
COS_TIMEZONE=America/Chicago

# Outlook is reached through the local COM interface (pywin32), against the
# desktop client's existing profile. There is no app registration, no MSAL
# token cache and no client secret to configure — which is the whole reason
# the pipeline runs on the desktop rather than against Graph.

# ── Ask bar (optional) ───────────────────────────────────────────────────────
# Powers the "Ask" bar on the overview page, which answers questions about the
# current book. Without it the dashboard runs normally and the bar returns a
# setup hint instead of an answer.
#
# Get a key at https://console.anthropic.com/settings/keys and paste it below.
# .env is gitignored — never commit a real key, and never paste one into any
# file that is tracked.
ANTHROPIC_API_KEY=sk-ant-...
